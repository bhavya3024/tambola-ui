# ─── Server & Application ──────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# ─── Database ──────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/tambola

# ─── Authentication & JWT ──────────────────────────────────────────
JWT_SECRET=tambola-super-secret-key-change-in-production
JWT_EXPIRY=15m
REFRESH_SECRET=tambola-refresh-secret-key-change-in-production
REFRESH_EXPIRY=7d

# ─── Email Configuration (SMTP) ───────────────────────────────────
# If left blank in dev mode, Ethereal test accounts will be automatically used.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Tambola <noreply@example.com>"
